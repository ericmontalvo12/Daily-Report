# Get your free API key at https://resend.com
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx

# The email address that will receive all reports
MANAGER_EMAIL=manager@yourcompany.com

# The "from" address (must be a verified domain in Resend)
