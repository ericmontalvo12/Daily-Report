# Your Gmail address (the one that sends the reports)
GMAIL_USER=you@gmail.com

# Google App Password (NOT your regular Gmail password)
# How to get one: https://myaccount.google.com/apppasswords
# (requires 2-Step Verification to be enabled on your Google account)
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# The project manager's email (where reports will be delivered)
MANAGER_EMAIL=manager@yourcompany.com
